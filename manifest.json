{
  "manifest_version": 3,
  "name": "Roposo Clout Product Sorter",
  "version": "1.0",
  "description": "Sort products on Roposo Clout by price, delivery ratio, etc.",

  "content_scripts": [
    {
      "matches": ["https://app.roposoclout.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
